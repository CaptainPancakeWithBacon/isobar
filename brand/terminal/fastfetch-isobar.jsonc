// Isobar in fastfetch, with plain-text labels (no icon font needed). Use: fastfetch -c brand/terminal/fastfetch-isobar.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.local/share/isobar/isobar-small.txt",
        "type": "file",
        "color": { "1": "38;2;151;216;172" },
        "padding": { "top": 1, "right": 2 }
    },
    "display": { "separator": " " },
    "modules": [
        { "key": "╭───────────╮", "type": "custom" },
        { "key": "│ {#31}user     {#keys}│", "type": "title", "format": "{user-name}" },
        { "key": "│ {#32}host     {#keys}│", "type": "title", "format": "{host-name}" },
        { "key": "│ {#33}uptime   {#keys}│", "type": "uptime" },
        { "key": "│ {#34}distro   {#keys}│", "type": "os" },
        { "key": "│ {#35}kernel   {#keys}│", "type": "kernel" },
        { "key": "│ {#36}desktop  {#keys}│", "type": "de" },
        { "key": "│ {#36}isobar   {#keys}│", "type": "command", "text": "isobar-status" },
        { "key": "│ {#31}shell    {#keys}│", "type": "shell" },
        { "key": "│ {#32}cpu      {#keys}│", "type": "cpu", "showPeCoreCount": true },
        { "key": "│ {#33}memory   {#keys}│", "type": "memory" },
        { "key": "├───────────┤", "type": "custom" },
        { "key": "│ {#39}colors   {#keys}│", "type": "colors", "symbol": "circle" },
        { "key": "╰───────────╯", "type": "custom" }
    ]
}
